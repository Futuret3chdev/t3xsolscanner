{
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://t3x.futuret3ch.com.au https://t3x-tawny.vercel.app https://www.futuret3ch.com.au"
        }
      ]
    }
  ]
}
